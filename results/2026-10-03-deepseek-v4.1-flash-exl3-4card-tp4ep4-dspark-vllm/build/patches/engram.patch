+@triton.jit
+def _engram_lookup_int4_kernel(
+    weight,
+    scales,
+    ids,
+    out,
+    vocab_start,
+    vocab_end,
+    num_rows,
+    ids_stride_t,
+    ids_stride_h,
+    HEAD_START: tl.constexpr,
+    LOCAL_HEADS: tl.constexpr,
+    TOTAL_HEADS: tl.constexpr,
+    DIM: tl.constexpr,
+    QUANT_BLOCK: tl.constexpr,
+    BLOCK_R: tl.constexpr,
+    GRID: tl.constexpr,
+):
+    """DSV41_ENGRAM_INT4 twin of _engram_lookup_kernel: rows are int4 offset-binary
+    (value = (q - 8) * scale), two per byte with the even column in the low nibble,
+    and scales are fp16 per QUANT_BLOCK."""
+    cols = tl.arange(0, DIM)
+    scale_cols = cols // QUANT_BLOCK
+    byte_cols = cols // 2
+    shift = (cols % 2) * 4
+    for base in tl.range(tl.program_id(0) * BLOCK_R, num_rows, GRID * BLOCK_R):
+        rows = base + tl.arange(0, BLOCK_R)
+        valid = rows < num_rows
+        head = HEAD_START + rows % LOCAL_HEADS
+        token = (rows // LOCAL_HEADS).to(tl.int64)
+        index = tl.load(
+            ids + token * ids_stride_t + head * ids_stride_h,
+            mask=valid & (head < TOTAL_HEADS),
+            other=-1,
+        ).to(tl.int64)
+        owned = valid & (head < TOTAL_HEADS)
+        owned &= (index >= vocab_start) & (index < vocab_end)
+        local = tl.where(owned, index - vocab_start, 0)
+        packed = tl.load(
+            weight + local[:, None] * (DIM // 2) + byte_cols[None, :],
+            mask=owned[:, None],
+            other=8,
+        ).to(tl.int32)
+        q = (packed >> shift[None, :]) & 0xF
+        scale = tl.load(
+            scales + local[:, None] * (DIM // QUANT_BLOCK) + scale_cols[None, :],
+            mask=owned[:, None],
+            other=0.0,
+        ).to(tl.float32)
+        tl.store(
+            out + rows[:, None] * DIM + cols[None, :],
+            ((q - 8).to(tl.float32) * scale).to(tl.bfloat16),
             mask=valid[:, None],
         )
 
 
+_ENGRAM_INT4 = os.environ.get("DSV41_ENGRAM_INT4") == "1"
