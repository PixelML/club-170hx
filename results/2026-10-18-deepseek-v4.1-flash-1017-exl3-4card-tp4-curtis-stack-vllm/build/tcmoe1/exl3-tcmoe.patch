+def _moe_tp_align() -> int:
+    """Column alignment for routed-expert TP shards (VLLM_EXL3_MOE_TP_ALIGN, 0 = off). Port of vcruz305/vllm-exl3 #36."""
+    try:
+        return int(os.environ.get("VLLM_EXL3_MOE_TP_ALIGN", "0"))
+    except ValueError:
+        return 0
+
