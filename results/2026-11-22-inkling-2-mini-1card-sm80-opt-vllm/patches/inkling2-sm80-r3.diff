+extern "C" void launch_markov_fold_gumbel_cache_r1_suf_sm80(
+    const void* latent,
+    const void* fold_w,
+    const void* fold_bias,
+    const void* base_logits,
+    const void* keep_ids,
+    const void* idx_map,
+    const void* temp_ptr,
+    const void* seeds_ptr,
+    const void* sample_pos_ptr,
+    const void* row_mapping_ptr,
+    const void* skip_flag_ptr,
+    void* keep_dirty_ptr,
+    void* logits_cache,
+    void* ws_max,
+    void* ws_id,
+    void* cta_counter,
