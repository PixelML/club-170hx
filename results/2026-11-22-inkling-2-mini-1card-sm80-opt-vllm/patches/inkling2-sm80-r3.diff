+        _ptr(w2_tensors.get("weight_scale_2")),
+        num_active.data_ptr(),
+        active_experts.data_ptr(),
+        active_slots.data_ptr(),
+        down.data_ptr(),
+        nv,
+        num_ctas_w2,
+        st,
+    )
+    return down
