+    block_max, block_local_idx = tl.max(score, axis=1, return_indices=True)
+    token_id = tl.load(
+        KEEP_IDS + pid_n * BN + block_local_idx,
+        mask=row_mask & ((pid_n * BN + block_local_idx) < K_vocab),
+        other=0,
+    )
