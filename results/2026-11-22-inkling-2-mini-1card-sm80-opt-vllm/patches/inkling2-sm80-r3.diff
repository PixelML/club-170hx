+            i64 = ctypes.c_int64
+            lib.launch_combine_conv_mix_r6_2304.argtypes = (
+                [vp] * 9
+                + [i64] * 3
+                + [i32] * 5
+                + [f32]
+                + [vp] * 8
+                + [i32, vp]
+                + [i64]
+                + [i32] * 4
+                + [f32, f32, vp]
