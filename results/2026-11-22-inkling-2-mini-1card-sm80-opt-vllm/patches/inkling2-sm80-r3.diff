+        or bank.shape[2] != 2304
+        or queries.shape != (4, 2304)
+        or bank.dtype != torch.bfloat16
+        or queries.dtype != torch.float32
+        or bank.stride(1) != 2304
+        or bank.stride(2) != 1
+        or (bank.stride(0) & 7) != 0
