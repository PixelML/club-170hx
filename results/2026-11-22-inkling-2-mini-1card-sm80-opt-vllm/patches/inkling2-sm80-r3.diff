+extern "C" void launch_markov_fold_gumbel_est_cache_r1_sm80(
+    const void* latent,
+    const void* fold_w,
+    const void* fold_bias,
+    const void* base_logits,
+    const void* keep_ids,
+    const void* idx_map,
+    const void* temp_ptr,
+    const void* seeds_ptr,
