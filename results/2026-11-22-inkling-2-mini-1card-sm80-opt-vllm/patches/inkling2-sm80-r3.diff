+        seeds_ptr,
+        pos_ptr,
+        logits_cache_ptr,
+        logits_cache_stride_0,
+        logits_cache_stride_1,
+        logits_cache_col_ptr,
+        None,
+        0,
+        logits_cache_row_mapping_ptr,
+        pruned_vocab_size,
+        IS_DRAFTING=True,
