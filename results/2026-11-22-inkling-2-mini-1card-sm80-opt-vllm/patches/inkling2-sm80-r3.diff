+@triton.jit
+def _fp32_to_e4m3fn_u8(x):
+    """Branchless IEEE round-to-nearest-even + satfinite FP32 -> E4M3FN uint8 for SM80."""
+    bits = x.to(tl.int32, bitcast=True)
+    sign = (bits >> 24) & 0x80
+    abs_bits = bits & 0x7FFFFFFF
+    ax = abs_bits.to(tl.float32, bitcast=True)
+    sub_m = (
+        tl.inline_asm_elementwise(
+            "add.rn.f32 $0, $1, 0f46800000;",
+            "=f,f",
+            [ax],
+            dtype=tl.float32,
+            is_pure=True,
+            pack=1,
+        ).to(tl.int32, bitcast=True)
+        & 0xFF
+    )
+    odd = (abs_bits >> 20) & 1
+    rounded = abs_bits + 0x7FFFF + odd
+    norm_em = tl.minimum(tl.maximum((rounded - 0x3C000000) >> 20, 0), 0x7E)
+    mag = tl.where(abs_bits < 0x3C800000, sub_m, norm_em)
+    u8 = tl.where(abs_bits > 0x7F800000, 0x7F, sign | mag)
+    return u8.to(tl.uint8)
+
